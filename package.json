{
  "name": "laptopilot",
  "private": true,
  "version": "1.0.0",
  "description": "AI-Powered Laptop Recommendation Assistant",
  "repository": {
    "type": "git",
    "url": "https://github.com/zSayf/laptopilot.git"
  },
  "keywords": [
    "laptop",
    "recommendation",
    "ai",
    "gemini",
    "assistant",
    "electron",
    "react",
    "typescript"
  ],
  "author": "Seif Elsayed",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:3005 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "tsc && vite build && electron-builder",
    "release": "npm run electron:build && node scripts/create-release.cjs",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name laptopilot",
    "deploy:cloudflare:preview": "npm run build && wrangler pages deploy dist --project-name laptopilot --branch preview"
  },
  "dependencies": {
    "@google/genai": "^1.21.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "electron-squirrel-startup": "^1.0.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.1",
    "wrangler": "^4.145.0"
  },
  "build": {
    "appId": "com.laptopilot.app",
    "productName": "LaptoPilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/*.cjs"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
